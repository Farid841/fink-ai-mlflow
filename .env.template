# Postgres
POSTGRES_USER="mlflow"
POSTGRES_PASSWORD="blabla-password-pour-postgres"
POSTGRES_DB="mlflow"

# RustFS
RUSTFS_ACCESS_KEY="blabla-access-key-pour-rustfs"
RUSTFS_SECRET_KEY="blabla-secret-key-pour-rustfs"
RUSTFS_HOST="rustfs"
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET="mlflow"
RUSTFS_BUCKET_DEV="mlflow-dev"

# MLflow Server
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow/
MLFLOW_S3_ENDPOINT_URL=https://blabla-rustfs-domain

# AWS region (for Boto3)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=${RUSTFS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${RUSTFS_SECRET_KEY}
AWS_ENDPOINT_URL=${MLFLOW_S3_ENDPOINT_URL}

# MLflow listen settings
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=24001
MLFLOW_SERVER_ALLOWED_HOSTS=blabla-mlflow-domain

# MLflow version (e.g., v3.3.0)
MLFLOW_VERSION=latest

# OIDC (à adapter)  
OIDC_REDIRECT_URI=https://blabla-mlflow-domain/callback
OIDC_DISCOVERY_URL=https://blabla-oidc-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=blabla-client-id  
OIDC_CLIENT_SECRET=blabla-client-secret
SECRET_KEY=blabla-secret-key-pour-sessions

# MLflow OIDC behaviour
AUTOMATIC_LOGIN_REDIRECT=true
DEFAULT_MLFLOW_PERMISSIONS=READ
OIDC_SCOPE=openid email profile 
OIDC_GROUPS_ATTRIBUTE=groups
OIDC_GROUP_NAME=mlflow
OIDC_ADMIN_GROUP_NAME=mlflow-admin
SKIP_USER_EXISTENCE_CHECK=true
DEFAULT_LANDING_PAGE_IS_PERMISSIONS=false

# Webhook Relay (MLflow → GitHub CI)
WEBHOOK_SECRET=blabla-hmac-secret-pour-mlflow-webhook
GITHUB_TOKEN=ghp_blabla-github-token-avec-scope-workflow
GITHUB_REPO=org/repo
TRIGGER_ALIASES=champion,challenger,release
WEBHOOK_RELAY_PORT=8080
# Clé de chiffrement des secrets de webhook côté MLflow
MLFLOW_WEBHOOK_SECRET_ENCRYPTION_KEY=blabla-encryption-key
# Compte de service MLflow utilisé par le relay pour récupérer le run_id
MLFLOW_RELAY_USERNAME=blabla-service-account
MLFLOW_RELAY_PASSWORD=blabla-service-account-password
